  <ifrs:DisclosureOfNotesAndOtherExplanatoryInformationExplanatory contextRef="p3">&lt;p class="MsoNormal" style="line-height: 105%"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Estados financieros consolidados&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpFirst" style="line-height: 105%; margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Estado de Situación Financiera&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpMiddle" style="line-height: 105%; margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Estado de Resultados y Otro Resultado Integral&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpMiddle" style="line-height: 105%; margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Estado de Cambios en el Patrimonio de los Accionistas&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="line-height: 105%; margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Estado de Flujos de Efectivo&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Notas de carácter general&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpFirst" style="line-height: 105%; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;     &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Información general&lt;/span&gt;&lt;/p&gt;&lt;p cl