   <ifrs:PrincipalPlaceOfBusiness contextRef="Dur_2015-01-01_2015-12-31P" id="dm-map2626962">Medellin</ifrs:PrincipalPlaceOfBusiness>
   <ifrs:NameOfParentEntity contextRef="Dur_2015-01-01_2015-12-31P" id="dm-map2626964">Empresas Públicas de Medellín E.S.P. (EPM)</ifrs:NameOfParentEntity>
