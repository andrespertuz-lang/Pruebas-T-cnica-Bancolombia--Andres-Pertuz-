height: 7.15pt"&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 190.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Servicios de personal&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 106.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                        149.281&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 99.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                   116.841&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 7.15pt"&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 190.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Operación y mantenimiento&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 106.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                          85.825&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 99.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                     75.130&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 7.15pt"&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 190.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Costos generales&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 106.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                          61.144&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 99.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                     56.342&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 7.15pt"&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 190.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Licencias y contribuciones&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 106.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                          36.890&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 7.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 99.25pt"&gt;&lt;p 