  <ifrs:DisclosureOfTradeAndOtherReceivablesExplanatory contextRef="p3">&lt;p class="MsoListParagraphCxSpFirst" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpMiddle" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;NOTA 10 - DEUDORES COMERCIALES Y OTRAS CUENTAS POR COBRAR, NETO&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpMiddle" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;El saldo de deudores comerciales y otras cuentas por cobrar, neto, al 31 de diciembre, comprendía:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="614" style="border-collapse: collapse; width: 460.5pt"&gt;&lt;tbody&gt;&lt;tr style="height: 12.75pt"&gt;&lt;td style="height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 265.5pt"/&gt;&lt;td style="height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 97.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;2017&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 97.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span styl