0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Combustibles&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 74.1pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;125&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 71.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;141&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 269.35pt"/&gt;&lt;td style="border: none; height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 74.1pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;107.111&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 71.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;100.194&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 59.75pt; margin-right: 0cm; margin-top: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;El 30 de junio de 2017 se terminó por vencimiento del plazo pactado entre las partes, el contrato de asistencia técnica que tenía firmado EPSA con Celsia desde el 29 de diciembre de 2009. Como consecuencia de lo anterior se realizó un proceso de fortalecimiento de los equipos humanos contratados por EPSA para poder suplir las funciones que anteriormente prestaba el operador estratégico, dando como consecuencia un incremento en las cuentas de nómina. Adicionalmente reajustes de nómina por aplicación de la inflación.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-left: 18.0pt; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(2)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Se liquidó el impuesto a la riqueza según la Ley 1739 del 23 de diciembre de 2014, tomando como base el patrimonio líquido poseído al 1º de enero de 2015 a una tarifa del 0.4% (2016- 1%). Para la obligación legal que se deberá causar el 1 de enero de 2017 el valor calculado es de $21.945 a una tasa del 0,4%.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-left: 18.0pt; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(3)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;El mayor valor corresponde al arrendamiento del edificio administrativo de Yumbo&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;(4)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Amortización de la implementación de Sap Hanna.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(5)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;En 2017 se reconoció deterioro de cartera de Electricaribe por $ 972 y por otras carteras por $1.402 (2016 $2.122), adicionalmente se presentó recuperación del deterioro de cartera de Termocandelaria por $1.008 (2016 - $ 4.557);  la compañía en el 2015 había registrado un deterioro por $6.566 de la cartera comercial con dicha compañía debido a los hechos de incumplimiento de esta empresa frente al mercado de energía.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfGeneralAndAdministrativeExpenseExplanatory>
  <ifrs:DisclosureOfFinanceIncomeExplanatory contextRef="p3">&lt;p class="MsoListParagraphCxSpFirst" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;NOTA 25 - INGRESOS FINANCIEROS&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Los ingresos financieros al 31 de diciembre; comprendía&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="533" style="border-collapse: collapse; width: 399.7pt"&gt;&lt;tbody&gt;&lt;tr style="height: 15.3pt"&gt;&lt;td style="height: 15.3pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 259.9pt"/&gt;&lt;td style="height: 15.3pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 68.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;2017&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.3pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 71.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;2016&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 15.3pt"&gt;&lt;td st