  <ifrs_2:DisclosureOfInventoriesExplanatory contextRef="p1_Duration">&lt;p class="MsoNormal" style="margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: -12.6pt; margin-top: 0cm"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;El saldo de inventarios comprende materiales, suministros y accesorios de energía.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; margin-left: 7.1pt; margin-right: -12.6pt; margin-top: 0cm"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="576" style="border-collapse: collapse; margin-left: 1.0cm; width: 432.35pt"&gt;&lt;tbody&gt;&lt;tr style="height: 13.15pt"&gt;&lt;td style="height: 13.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 205.55pt"/&gt;&lt;td style="height: 13.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 59.6pt"/&gt;&lt;td style="height: 13.15pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 7.3pt"/&gt;&lt;td colspan="3" style="height: 13.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2014&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 26.95pt"&gt;&lt;td style="height: 26.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 205.55pt"/&gt;&lt;td style="border: none; border-bottom: solid black 1.0pt; height: 26.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 59.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2015&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 26.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 7.3pt"/&gt;&lt;td style="border: none; border-bottom: solid black 1.0pt; height: 26.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 81.95pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;31 de diciembre&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 26.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.15pt"/&gt;&lt;td style="border: none; border-bottom: solid black 1.0pt; height: 26.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 69.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1 de enero&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.55pt"&gt;&lt;td style="height: 12.55pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 205.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Materiales repuestos y accesorios&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 59.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;$   9.552.773&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 7.3pt"/&gt;&lt;td style="height: 12.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 81.95pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;$        9.017.103&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 8.15pt"/&gt;&lt;td style="height: 12.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 69.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;$ 7.425.028&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; margin-left: 0cm; margin-right: -12.6pt; margin-top: 0cm"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-right: .1pt; text-align: justify; text-indent: 18.0pt"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-right: .1pt; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Durante 2015 se reconocieron $556.215 como gasto, $8.069.997 al costo y $26.224.636 a proyectos.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-right: .1pt; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;En 2014 se reconocieron $402.509 como gasto, $7.686.512 al costo y $27.057001 a proyectos.&lt;/span&gt;&lt;/p&gt;</ifrs_2:DisclosureOfInventoriesExplanatory>
  <ifrs:DisclosureOfIssuedCapitalExplanatory contextRef="p1_Duration">&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="483" style="border-collapse: collapse; width: 362.05pt"&gt;&lt;tbody&gt;&lt;tr style="height: 14.4pt"&gt;&lt;td style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 92.0pt"/&gt;&lt;td style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 78.0pt"/&gt;&lt;td style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 17.0pt"/&gt;&lt;td colspan="3" style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2014&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 27.0pt"&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 92.0pt"/&gt;&lt;td style="border: none; border-bottom: solid black 1.0pt; height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 78.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2015&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 17.0pt"/&gt;&lt;td style="border: none; border-bottom: solid black 1.0pt; height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 89.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;31 de diciembre&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 16.0pt"/&gt;&lt;td style="border: none; border-bottom: solid black 1.0pt; height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 69.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1 de enero&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 14.4pt"&gt;&lt;td style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 92.0pt"/&gt;&lt;td valign="bottom" style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 78.0pt"/&gt;&lt;td valign="bottom" style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.0pt"/&gt;&lt;td valign="bottom" style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.45pt"/&gt;&lt;td valign="bottom" style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 16.0pt"/&gt;&lt;td valign="bottom" style="height: 14.4pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 69.6pt"/&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 92.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Capital en acciones&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 78.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;$1.128.166.225&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.0pt"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;$1.128.166.225&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 16.0pt"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 69.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;$1.128.166.225&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: 12.0pt"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 12.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El capital autorizado de la Compañía está representado en 346.701.360 acciones, con un valor nominal de $3.254 pesos por acción; el capital suscrito y pagado asciende a $1.128.166.225 y el número de acciones en circulación asciende a 346.701.360.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfIssuedCapitalExplanatory>
  <ifrs:DisclosureOfShareCapitalReservesAndOtherEquityInterestExplanatory contextRef="p1_Duration">&lt;p class="MsoNormal" style="margin-left: 18.0pt; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Reserva legal&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 12.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;EPSA está obligada por ley a apropiar el 10% de sus ganancias netas anuales para reserva legal hasta que el saldo de esta reserva, que no puede distribuirse antes de la liquidación de la Compañía pero que se debe utilizar para absorber o reducir pérdidas, sea equivalente por lo menos al 50% del capital suscrito. EPSA puede disponer del exceso de este monto para otras apropiaciones, de acuerdo con lo que disponga la Asamblea de Accionistas. En el 2015 se constituyó reserva legal por $34.149.517 (2014 - $27.951.826) incrementando el saldo de esta reserva de $276.784.801 en 2014 a $310.934.318 en 2015.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-left: 18.0pt; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Reservas voluntarias&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 18.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Incluye reservas para mantenimiento del patrimonio, las cuales han sido constituidas por disposición de la Asamblea General de Accionistas con fines específicos. En 2015 se constituyó reserva ocasional para mantenimiento del patrimonio por $307.346.000, adicionalmente se apropió $239.223.938 para distribución de dividendos. Al 31 de diciembre de 2015, el saldo de las reservas voluntarias es de $205.364.582 (2014 - $137.242.868).&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-left: 18.0pt; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Reservas por depreciación fiscal&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 18.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;La Compañía constituyó una reserva por $33.410.219, la cual corresponde al 70% de la mayor deducción por depreciación fiscal en cumplimiento de lo establecido en el artículo 130 del Estatuto Tributario. Dicha reserva se mantiene durante el 2015 y 2014.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 8.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 12.0pt; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Reservas para readquisición de acciones&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-left: 18.0pt; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;El saldo de la reserva para readquisición de acciones es para 2015 y 2014 de $11.091.862, correspondiente a 54.402 acciones.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfShareCapitalReservesAndOtherEquityInterestExplanatory>
  <ifrs:DisclosureOfProvisionsExplanatory contextRef="p1_Duration">&lt;div style="text-align: center"&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="559" style="border-collapse: collapse; width: 419.0pt"&gt;&lt;tbody&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td valign="bottom" style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 206.4pt"/&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 74.8pt"/&gt;&lt;td colspan="2" style="border: none; border-bottom: solid windowtext 1.0pt; height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2014&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 27.0pt"&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 206.4pt"/&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 74.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2015&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 69.9pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;31 de diciembre&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 27.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 67.9pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1 de enero&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 