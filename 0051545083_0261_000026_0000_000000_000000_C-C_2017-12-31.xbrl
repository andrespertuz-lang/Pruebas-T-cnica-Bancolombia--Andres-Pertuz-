"font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(9.489)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="padding: 0cm 5.75pt 0cm 5.75pt; width: 261.0pt"&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Total impuesto a las ganancias reconocido en otro resultado integral&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; padding: 0cm 5.75pt 0cm 5.75pt; width: 99.0pt"&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;                         &lt;/span&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(1.928&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; padding: 0cm 5.75pt 0cm 5.75pt; width: 94.5pt"&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;                       &lt;/span&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(9.489)&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&l