292.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Dividendos decretados&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 14.15pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 71.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;     (200.740)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 14.15pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 71.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;     (173.352)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 14.15pt"&gt;&lt;td style="height: 14.15pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 292.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Saldo al final del periodo (1)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 14.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 71.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;$201.055&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 14.15pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 71.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;$242.101&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;En 2017 se decretaron dividendos a razón de $579 pesos sobre 346.701.360 acciones, dividendo total de $200.740.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Incluye $8.736 (2015- $8.736) correspondientes a los efectos de transición a NIIF Vs. Colgaap del resultado 2014.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfDividendsExplanatory>
  <ifrs:DisclosureOfIncomeTaxExplanatory contextRef="p3">&lt;p class="MsoNormal"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;NOTA 30 - IMPUESTO A LAS GANANCIAS&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Las disposiciones fiscales aplicables a la compañía estipulan que la tarifa al impuesto sobre la    renta para los años 2016 es del 25% y 2017 es del 34% y el impuesto sobre la renta para la equidad &#8211; CREE es del 9%, respectivamente. Asimismo se establece una sobretasa del impuesto CREE del 6% para compañías cuya utilidad sea igual o superior a $800 millones.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-left: 0cm; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;30.1 Impuesto a las ganancias reconocido en el estado de resultados&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="473" style="border-collapse: collapse; width: 355.0pt"&gt;&lt;tbody&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 235.0pt"/&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;2017&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;2016&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 235.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Impuesto corriente:&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"/&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"/&gt;&lt;/tr&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 235.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-indent: 27.0pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Con respecto al año actual&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;172.349&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;184.220&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="hei