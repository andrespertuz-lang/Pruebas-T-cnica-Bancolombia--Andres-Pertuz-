9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;5.548&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 10.6pt"&gt;&lt;td valign="bottom" style="height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 300.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Recuperación de deterioro reconocidas&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 65.1pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;-&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 56.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(1.062)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 10.6pt"&gt;&lt;td style="height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 300.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Castigo de importes considerados como incobrables&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 65.1pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(1.480)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 56.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(2.376)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 10.6pt"&gt;&lt;td style="height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 300.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Saldo al final del año&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 65.1pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;45.012&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 10.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 56.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;32.973&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;La compañía luego de evaluación realizada con el método de la pérdida esperada y el análisis de cartera al 31 de diciembre de 2019, no se encuentra evidencia objetiva de que los saldos por cobrar vencidos presenten riesgos crediticios significativos.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify"&gt;&lt;span&gt;A&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;partir del 1° de enero de 2018, la compañía implementó la norma NIIF 9, en donde se reconocen las pérdidas esperadas.&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;A continuación, se detalla el movimiento.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoTableGrid" border="0" cellspacing="0" cellpadding="0" width="587" style="border: none; border-collapse: collapse; width: 440.05pt"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td valign="top" style="border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 147.15pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;31 De diciembre 2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 2.0cm"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Tasa de pérdida de crédito&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="border: none; border-bottom: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bott