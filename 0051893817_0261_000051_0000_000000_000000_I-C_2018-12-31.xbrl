  <ifrs:TitleOfNewIFRS contextRef="id1938">NIIF 16 Arrendamientos</ifrs:TitleOfNewIFRS>
  <ifrs:DescriptionOfNatureOfImpendingChangeInAccountingPolicy contextRef="id1938">N/A</ifrs:DescriptionOfNatureOfImpendingChangeInAccountingPolicy>
