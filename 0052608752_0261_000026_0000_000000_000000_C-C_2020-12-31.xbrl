rial&amp;quot;,sans-serif"&gt;22.292&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 16.88%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(13.426)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 66.22%"/&gt;&lt;td style="border: none; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 16.9%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;174.971&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 16.88%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;235.798&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-left: 0cm; text-align: justify"&gt;&lt;span class="normaltextrun"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; background: white"&gt;La siguiente es la conciliación entre la ganancia antes de impuestos y la renta líquida gravable por los períodos terminados al 31 de diciembre de 2020 y 2019:&lt;/span&gt;&lt;/span&gt;&lt;span class="eop"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-fa