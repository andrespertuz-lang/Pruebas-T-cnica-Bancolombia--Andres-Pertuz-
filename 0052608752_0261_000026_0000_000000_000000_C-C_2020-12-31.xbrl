  <ifrs:DisclosureOfOtherLiabilitiesExplanatory contextRef="p3">&lt;p class="NotasCartilla"&gt;&lt;span style="color: windowtext"&gt;NOTA 22. otro pasvos no financieros&lt;b&gt; &lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpFirst" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los otros pasivos no financieros, al 31 de diciembre de 2020 y 2019, comprendían:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;div style="text-align: center"&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="595" style="border-collapse: collapse; width: 446.1pt"&gt;&lt;tbody&gt;&lt;tr style="height: 8.45pt"&gt;&lt;td valign="bottom" style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 246.6pt"/&gt;&lt;td style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 105.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 94.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 8.45pt"&gt;&lt;td valign="bottom" style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 246.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;&#8203;Recaudos a favor de terceros (1) &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 105.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                         &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;28.544&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 94.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                     28.244&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 8.45pt"&gt;&lt;td valign="bottom" style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 246.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Ingresos recibidos por anticipado (2)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 105.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                            1.587&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 94.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                     18.379&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 8.45pt"&gt;&lt;td valign="bottom" style="height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 246.6pt"/&gt;&lt;td style="border-bottom: solid windowtext 1.0pt; border-left: none; border-right: none; border-top: solid windowtext 1.0pt; height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 105.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                          30.131&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border-bottom: solid windowtext 1.0pt; border-left: none; border-right: none; border-top: solid windowtext 1.0pt; height: 8.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 94.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                     46.623&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p class="MsoListParagraphCxSpFirst" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpMiddle" style="margin-bottom: .0001pt; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El saldo está conformado por recaudos a favor de terceros por el servicio de aseo y alumbrado público que presta la compañía.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-bottom: .0001pt; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(2)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;La disminución corresponde a la amortización del valor recibido de manera anticipada por servicio de energía prepagada de Empresa de Energía de Pereira S.A E.S.P.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfOtherLiabilitiesExplanatory>
  <ifrs:DisclosureOfRevenueExplanatory contextRef="p3">&lt;p class="NotasCartilla"&gt;&lt;span style="color: windowtext"&gt;NOTA 23. INGRESOS DE ACTIVIDADES ORDINARIAS&lt;b&gt; &lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los ingresos de actividades ordinarias por las actividades de prestación de servicios, al 31 de diciembre de 2020 y 2019 comprendían:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;div style="text-align: center"&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="590" style="border-collapse: collapse; width: 442.75pt"&gt;&lt;tbody&gt;&lt;tr style="height: 8.05pt"&gt;&lt;td style="height: 8.05pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 247.75pt"/&gt;&lt;td style="height: 8.05pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 103.75pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.05pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 91.25pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 16.1pt"&gt;&lt;td style="height: 16.1pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 247.75pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;