  <ifrs:DeferredTaxExpenseIncomeRelatingToOriginationAndReversalOfTemporaryDifferences decimals="0" contextRef="TrimestreAcumuladoActual" unitRef="COP">66485085</ifrs:DeferredTaxExpenseIncomeRelatingToOriginationAndReversalOfTemporaryDifferences>
