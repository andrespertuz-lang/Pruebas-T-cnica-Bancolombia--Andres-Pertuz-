ze: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;3.653.885&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;3.680.433&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 241.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Maquinaria y equipo&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;50.664&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 60.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;44.394&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 241.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Muebles, enseres y equipos de oficina&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt