  <co-sfc-core:DescripcionRazonesEntidadConsideroReparticionUtilidadesYoDividendosAdelantarProcesosCapitalizacionEnjugarPerdidasReconocerReservas contextRef="p3">0</co-sfc-core:DescripcionRazonesEntidadConsideroReparticionUtilidadesYoDividendosAdelantarProcesosCapitalizacionEnjugarPerdidasReconocerReservas>
