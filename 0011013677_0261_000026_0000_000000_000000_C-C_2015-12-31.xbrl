  <ifrs:DisclosureOfRevenueExplanatory contextRef="p1_Duration">&lt;p class="MsoBodyTextIndent" style="text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;A continuación se presentan los ingresos del período de la Compañía para operaciones que continúan.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Ingresos de actividades ordinarias&lt;/span&gt;&lt;/p&gt;&lt;div style="text-align: center"&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="487" style="border-collapse: collapse; width: 365.0pt"&gt;&lt;tbody&gt;&lt;tr style="height: 13.2pt"&gt;&lt;td valign="bottom" style="height: 13.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 217.0pt"/&gt;&lt;td valign="bottom" style="border: none; border-bottom: solid windowtext 1.0pt; height: 13.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 74.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2015&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="border: none; border-bottom: solid windowtext 1.0pt; height: 13.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 74.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2014&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 31.0pt"&gt;&lt;td style="height: 31.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 217.0pt"/&gt;&lt;td valign="bottom" style="height: 31.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 74.0pt"/&gt;&lt;td valign="bottom" style="height: 31.0pt; padding: 0cm 3.5pt 0