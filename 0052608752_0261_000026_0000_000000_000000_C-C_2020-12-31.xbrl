p;quot;Arial&amp;quot;,sans-serif"&gt;                   40.293&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 8.5pt"&gt;&lt;td style="height: 8.5pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 55.72%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Equipo de transporte  &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.5pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.7%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;143.856&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 8.5pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 24.58%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;                   19.497&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 8.5pt"&gt;&lt;td style="height: 8.5pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 55.72%"&gt;&lt;p class="Tablas" style="text-align: left"&gt;&lt;span style="color: windowtext"&gt;Total, propiedades, planta y equipo, neto &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border-bottom: double windowtext 2.25pt; border-left: none; border-right: none; border-top: solid windowtext 1.0pt; height: 8.5pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.7%"&gt;&lt;p class="Tablas"&gt;&lt;span style="color: windowtext"&gt;7.140.538&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border-bottom: double windowtext 2.25pt; border-left: none; border-right: none; border-top: solid windowtext 1.0pt; height: 8.5pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 24.58%"&gt;&lt;p class="Tablas"&gt;&lt;span style="color: windowtext"&gt;             6.592.943&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/