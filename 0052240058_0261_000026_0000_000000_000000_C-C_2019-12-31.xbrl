.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;-&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 13.0pt"&gt;&lt;td style="height: 13.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 225.0pt"/&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 13.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 75.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;46.623&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 13.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 75.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;20.645&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoListParagraphCxSpFirst" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpMiddle" style="margin-bottom: .0001pt; page-break-after: avoid; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El saldo está conformado por recaudos a favor de terceros por el servicio de aseo y alumbrado público que presta la compañía.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-bottom: .0001pt; page-break-after: avoid; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(2)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Corresponde al valor recibido de manera anticipada por servicio de energía prepagada de  Empresa de Energía de Pereira S.A E.S.P&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfOtherLiabilitiesExplanatory>
  <ifrs:DisclosureOfRevenueExplanatory contextRef="p3">&lt;p class="MsoListParagraph" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;NOTA 22 - INGRESOS DE ACTIVIDADES ORDINARIAS &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los ingresos de actividades ordinarias por las actividades de prestación de servicios, al 31 de diciembre de 2019 y 2018 comprendían:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="559" style="border-collapse: collapse; margin-left: 3.5pt; width: 419.0pt"&gt;&lt;tbody&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 268.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 77.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 72.65pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2018&lt;/span&gt;&lt;/b&gt;&