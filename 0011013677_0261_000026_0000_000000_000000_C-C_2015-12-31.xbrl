  <ifrs:ProceedsFromBorrowingsClassifiedAsFinancingActivities decimals="0" contextRef="p1_Duration" unitRef="COP">0</ifrs:ProceedsFromBorrowingsClassifiedAsFinancingActivities>
  <ifrs:NameOfReportingEntityOrOtherMeansOfIdentification contextRef="p1_Duration">EPSA</ifrs:NameOfReportingEntityOrOtherMeansOfIdentification>
  <co-sfc-core:NITEntidadinforma contextRef="p1_Duration">8002498601</co-sfc-core:NITEntidadinforma>
  <ifrs:ExplanationOfChangeInNameOfReportingEntityOrOtherMeansOfIdentificationFromEndOfPrecedingReportingPeriod contextRef="p1_Duration">0</ifrs:ExplanationOfChangeInNameOfReportingEntityOrOtherMeansOfIdentificationFromEndOfPrecedingReportingPeriod>
  <ifrs:DescriptionOfNatureOfFinancialStatements contextRef="p1_Duration">Estados financieros consolidados</ifrs:DescriptionOfNatureOfFinancialStatements>
  <ifrs:DateOfEndOfReportingPeriod contextRef="p1_Instant">2015-12-31</ifrs:DateOfEndOfReportingPeriod>
  <ifrs:PeriodCoveredByFinancialStatements contextRef="p1_Duration">Enero 1 a Diciembre de 2015 y Enero 1 a Diciembre de 2014</ifrs:PeriodCoveredByFinancialStatements>
  <co-sfc-core:NombreCompaniaAuditoriaExternaRevisoriaFiscal contextRef="p1_Duration">Deloitte &amp; Touche</co-sfc-core:NombreCompaniaAuditoriaExternaRevisoriaFiscal>
  <co-sfc-core:NombreSocioAuditorFirmaOpinion contextRef="p1_Duration">Heyman Antonio Gil Balcázar</co-sfc-core:NombreSocioAuditorFirmaOpinion>
  <co-sfc-core:TipoOpinionEstadosFinancieros contextRef="p1_Duration">0</co-sfc-core:TipoOpinionEstadosFinancieros>
