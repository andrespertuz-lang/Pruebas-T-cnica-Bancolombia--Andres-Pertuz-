  <ifrs:OtherTangibleOrIntangibleAssetsTransferred decimals="0" contextRef="C817000Y1_Instant_EntitysTotalForBusinessCombinationsMember" unitRef="COP">0</ifrs:OtherTangibleOrIntangibleAssetsTransferred>
