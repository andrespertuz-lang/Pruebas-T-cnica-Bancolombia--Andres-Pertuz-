style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(9.982)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: .8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 91.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(8.533)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 9.6pt"&gt;&lt;td style="height: 9.6pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 258.75pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Transferencias y otros cambios&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 9.6pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 90.85pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;31&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 9.6pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 91.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(31)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: .8pt"&gt;&lt;td style="height: .8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 258.75pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Actualización financiera de provisiones existentes&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: .8pt; padding: 0