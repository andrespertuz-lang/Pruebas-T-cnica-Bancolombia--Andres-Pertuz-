  <ifrs:DateOfEndOfReportingPeriodOfFinancialStatementsOfJointVenture contextRef="C825700dY1_Instant_AggregatedIndividuallyImmaterialJointVenturesMember">0001-01-01</ifrs:DateOfEndOfReportingPeriodOfFinancialStatementsOfJointVenture>
