  <ifrs:DisclosureOfTradeAndOtherReceivablesExplanatory contextRef="p3">&lt;p class="MsoListParagraphCxSpFirst" style="margin-left: 0cm"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;NOTA 10 - DEUDORES COMERCIALES Y OTRAS CUENTAS POR COBRAR, NETO&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-left: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El saldo de deudores comerciales y otras cuentas por cobrar, neto, al 31 de diciembre, comprendía:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="549" style="border-collapse: collapse; margin-left: 3.5pt; width: 412.0pt"&gt;&lt;tbody&gt;&lt;tr style="height: 15.0pt"&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 274.8pt"/&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 67.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2018&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 15.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 69.6pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2017&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 274.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Cuentas comerciales por cobrar y otras cuentas por cobrar (1)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="